<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "windows-installer" (.github/workflows/release.yml): the GitHub artifact holds
     PointTaken-<version>-windows-x64-setup.exe, built from the already signed app. Slug: windows-installer. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set>
      <include path="PointTaken-*-windows-x64-setup.exe" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
